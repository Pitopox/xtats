# Copia este archivo como .env.local y completa con los datos de tu proyecto:
# Supabase → Project Settings → API (URL del proyecto y la clave publicable "sb_publishable_…").
# Sin estas dos variables la app funciona en modo demo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
